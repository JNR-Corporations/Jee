rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} { allow read, create, update: if isOwner(uid); allow delete: if false; }
    match /users/{uid}/{sub=**} { allow read, write: if isOwner(uid); }
    match /subjects/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /chapters/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /topics/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /questions/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /tests/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notes/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /importantTopics/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /testAttempts/{id} { allow read, create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if signedIn() && resource.data.userId == request.auth.uid; allow delete: if false; }
    match /userProgress/{id} { allow read, write: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /bookmarks/{id} { allow read, write: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /studySessions/{id} { allow read, write: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /dailyGoals/{id} { allow read, write: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /leaderboard/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
